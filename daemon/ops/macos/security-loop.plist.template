<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>@LAUNCHD_PREFIX@.security-loop</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/sbin/run-daemon.sh</string>
    <string>dist/security-loop-cli.js</string>
  </array>
  <key>UserName</key><string>@SERVICE_USER@</string>
  <key>GroupName</key><string>staff</string>
  <key>WorkingDirectory</key><string>@SERVICE_HOME@/linear-agent-daemon</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>@SERVICE_HOME@</string>
    <key>USER</key><string>@SERVICE_USER@</string>
    <key>PATH</key><string>/usr/local/bin:@SERVICE_HOME@/.local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>@SERVICE_HOME@/Library/Logs/security-loop.log</string>
  <key>StandardErrorPath</key><string>@SERVICE_HOME@/Library/Logs/security-loop.log</string>
</dict>
</plist>
